{
  "name": "wetlsp-explorer",
  "private": true,
  "version": "1.2.7",
  "type": "module",
  "description": "Explore Wetland Land Surface Phenology datasets locally on macOS and Windows.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:import": "node scripts/import-catalog.mjs",
    "predev": "node scripts/copy-duckdb.mjs && node scripts/gen-icons.mjs && node scripts/fetch-fonts.mjs",
    "prebuild": "node scripts/copy-duckdb.mjs && node scripts/gen-icons.mjs && node scripts/fetch-fonts.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "build:desktop": "npm run build -- --mode desktop",
    "desktop": "npm run build:desktop && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --dir --publish never",
    "desktop:dist": "npm run build:desktop && electron-builder --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "samples": "node scripts/prepare-samples.mjs",
    "samples:publish": "node scripts/publish-samples.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "9.4.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "apache-arrow": "^17.0.0",
    "clsx": "^2.1.1",
    "deck.gl": "9.4.0",
    "h5wasm": "^0.7.8",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "5.24.0",
    "plotly.js-dist-min": "^2.35.2",
    "proj4": "^2.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.5",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "main": "desktop/main.mjs",
  "author": "Bhagyesh Sagole and Pawan Kumar",
  "license": "MIT"
}
